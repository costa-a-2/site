{
  "buildCommand": "npx @11ty/eleventy",
  "outputDirectory": "_site",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/rankings/football", "destination": "/rankings/", "permanent": true }
  ]
}
