---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }}</title>
  <subtitle>{{ site.tagline }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <updated>{% if collections.articles.length %}{{ (collections.articles[0].data.updated or collections.articles[0].date) | isoDate }}{% else %}{{ build.iso }}{% endif %}</updated>
  <author><name>{{ site.author }}</name><uri>{{ site.url }}{{ site.authorUrl }}</uri></author>
  <rights>© {{ site.founded }} {{ site.name }}</rights>
{%- for a in collections.articles %}
  <entry>
    <title>{{ a.data.title }}</title>
    <link href="{{ site.url }}{{ a.url }}"/>
    <id>{{ site.url }}{{ a.url }}</id>
    <published>{{ a.date | isoDate }}</published>
    <updated>{{ (a.data.updated or a.date) | isoDate }}</updated>
    <author><name>{{ site.author }}</name></author>
    {%- if a.data.section %}
    <category term="{{ a.data.section }}"/>
    {%- endif %}
    <summary>{{ a.data.summary or a.data.standfirst }}</summary>
    <content type="html">{{ a.templateContent | absoluteUrls(site.url) }}</content>
  </entry>
{%- endfor %}
</feed>
