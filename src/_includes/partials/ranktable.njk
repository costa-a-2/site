<div class="tbl-wrap">
<table class="rank" id="rankTable">
  <thead><tr>
    <th>#</th><th class="c-model">Model</th><th>Player</th><th class="c-pos">Pos</th><th class="c-team">Tm</th>
    <th class="c-ppg">PPG</th><th class="c-spark">Trend</th><th style="text-align:right">Chg</th>{% if week.hasOts %}<th style="text-align:right">OTS</th>{% endif %}<th class="c-risk">Risk</th>
  </tr></thead>
  <tbody>
  {% for block in week.players | byTier %}
    <tr class="tier-head"><td colspan="{{ 10 if week.hasOts else 9 }}">{{ block.name }}{% if block.cliff !== null and block.cliff !== undefined %}<span class="gap">cliff: {{ block.cliff }} PPG over replacement</span>{% endif %}</td></tr>
    {% for p in block.players %}{% set m = p.change | movement(week.firstEdition) %}
      <tr data-pos="{{ p.pos }}" data-team="{{ p.team }}" id="p-{{ p.player | slugify }}">
        <td class="c-rank">{{ p.rank }}</td>
        <td class="c-model">{% if p.modelRank %}{{ p.modelRank }}{% else %}—{% endif %}</td>
        <td class="c-player">{% if p.headshot %}<img class="hs" src="{{ p.headshot }}" alt="" loading="lazy">{% else %}<span class="hs"></span>{% endif %}<a href="/players/{{ p.player | slugify }}/">{{ p.player }}</a>{% for b in p.badges %}<span class="badge">{{ b }}</span>{% endfor %}</td>
        <td class="c-pos">{{ p.pos }}</td>
        <td class="c-team">{{ p.team }}</td>
        <td class="c-ppg">{% if p.ppg is defined and p.ppg !== null %}{{ p.ppg.toFixed(1) }}{% else %}—{% endif %}</td>
        <td class="c-spark">{{ p.history | sparkline | safe }}</td>
        <td class="c-chg {{ m.cls }}">{{ m.sym }}{% if m.abs %} {{ m.abs }}{% endif %}</td>
        {% if week.hasOts %}<td class="c-ots">{% if p.ots is defined %}{% if p.ots > 0 %}+{{ p.ots }}{% elif p.ots < 0 %}&minus;{{ p.ots | abs }}{% else %}0{% endif %}{% else %}—{% endif %}</td>{% endif %}
        <td class="c-risk">{% if p.risk %}<span class="risk-dot {{ p.risk | riskClass }}" title="{{ p.note or p.risk }}"></span><span class="risk-lbl">{{ p.risk }}</span>{% endif %}</td>
      </tr>
    {% endfor %}
  {% endfor %}
  </tbody>
</table>
</div>
<div class="tbl-foot">Model = where the projection model had him before judgment &middot; PPG = projected half-PPR points per game &middot; badges are computed from the projected share, never typed &middot; cliff = the drop in value over replacement from this tier's last player to the next tier's first &middot; Trend = rank over the last six weeks &middot; Chg ={% if week.firstEdition %}movement, starting next edition &mdash; this is the baseline{% else %}movement vs. {{ "preseason baseline" if week.week == 1 else "prior week" }}{% endif %}{% if week.hasOts %}{% for m in metrics %}{% if m.key == "OTS" %} &middot; {{ m.key }} = {{ m.name }}{% endif %}{% endfor %}{% endif %} &middot; <a href="/methodology/" style="border-bottom:1px solid var(--rule)">How we build these</a></div>
