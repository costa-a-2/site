---
layout: layouts/base.njk
---
<div class="dateline"><span>{{ section }}</span><span>{{ date | date("long") }}</span><span>{{ readtime }}</span></div>
<div class="r-light"></div>

<article>
  <div style="padding:30px 0 16px;max-width:820px">
    <span class="sec">{{ kicker or section }}</span>
    <h1 class="hed-xl" style="margin-top:12px">{{ title }}</h1>
    <p class="standfirst" style="margin-top:14px;max-width:680px">{{ standfirst }}</p>
    <div class="byline">
      <img class="mug" src="{{ site.authorMug or '/assets/img/costa.jpg' }}" alt="" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'mug'}))">
      <div><div class="who">{{ site.author }}</div><div class="role">Editor &middot; {{ site.handle }}</div></div>
    </div>
  </div>

  {% if image %}<figure><img src="{{ image }}" alt="{{ imageAlt }}"><figcaption>{{ caption }}</figcaption></figure>{% endif %}
  <div class="r-hair" style="margin:26px 0 22px"></div>

  <div class="art-grid" style="display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:36px">
    <div class="prose">
      {% if datelineCity %}<p class="dropcap"><span class="dateline-inline">{{ datelineCity }} —</span> {{ lede }}</p>{% endif %}
      {{ content | safe }}
    </div>
    <aside style="border-left:1px solid var(--rule);padding-left:22px">
      {% set wk = rankings.latestFootball %}
      <span class="sec">Top of the Board</span>
      <table class="rank" style="font-size:13.5px;margin-top:8px">
        {% for p in wk.players | limit(8) %}{% set m = p.change | movement(wk.firstEdition) %}
        <tr><td class="c-rank" style="width:20px">{{ p.rank }}</td><td class="c-player">{{ p.player }}</td><td class="c-chg {{ m.cls }}">{{ m.sym }}{% if m.abs %} {{ m.abs }}{% endif %}</td></tr>
        {% endfor %}
      </table>
      <a href="/rankings/" class="btn-ink" style="margin-top:8px">All {{ wk.count }} &rarr;</a>
      <div style="margin-top:20px"><span class="sec">Biggest Movers</span></div>
      <div style="margin-top:8px">{% set week = wk %}{% set n = 3 %}{% include "partials/ladder.njk" %}</div>
    </aside>
  </div>
</article>
<style>@media (max-width:860px){.art-grid{grid-template-columns:1fr !important;gap:22px !important}.art-grid aside{border-left:none !important;border-top:1px solid var(--ink);padding-left:0 !important;padding-top:20px}}</style>
